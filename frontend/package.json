{
  "name": "deduparr-frontend",
  "private": true,
  "version": "0.5.5",
  "type": "module",
  "description": "Frontend for Deduparr - Duplicate media management for the *arr ecosystem",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "security-check": "npm audit && npm outdated",
    "quality": "npm run type-check && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-aspect-ratio": "1.2.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.2.24",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.5",
    "axios": "^1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "input-otp": "1.5.0",
    "lucide-react": "1.50.0",
    "next-themes": "0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.3.1",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "17.13.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4"
  }
}
