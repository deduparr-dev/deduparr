# Builds the frontend development image from frontend/Dockerfile.dev.
# Requires Podman 5.0 or newer (.build quadlets).
#
# REPO_ROOT: adjust File= if the checkout is not at /workspaces/deduparr.

[Unit]
Description=Build Deduparr frontend development image

[Build]
ImageTag=localhost/deduparr-frontend-dev:latest
File=/workspaces/deduparr/frontend/Dockerfile.dev
